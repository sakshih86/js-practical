<!DOCTYPE html>
<html>
<head>
    <title>String Comparison</title>
</head>
<body>

    <h2>Compare Two Strings</h2>

    <script>
        let str1 = "Hello";
        let str2 = "hello";

        document.write("First String: " + str1 + "<br>");
        document.write("Second String: " + str2 + "<br><br>");

        document.write("Using == : " + (str1 == str2) + "<br>");
        document.write("Using === : " + (str1 === str2) + "<br>");
        document.write("Using != : " + (str1 != str2) + "<br>");
        document.write("Using localeCompare(): " + str1.localeCompare(str2) + "<br>");

        document.write("Case-insensitive comparison: " +
            (str1.toLowerCase() === str2.toLowerCase()));
    </script>

</body>
</html>
