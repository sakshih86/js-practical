<!DOCTYPE html>
<html>
<head>
    <title>Array Operations</title>
</head>
<body>

    <h2>Array Operations</h2>

    <script>
        let fruits = ["Apple", "Banana", "Mango"];

        document.write("Original Array: " + fruits + "<br>");

        fruits.push("Orange");
        document.write("After Push: " + fruits + "<br>");

        fruits.pop();
        document.write("After Pop: " + fruits + "<br>");

        fruits.unshift("Grapes");
        document.write("After Unshift: " + fruits + "<br>");

        fruits.shift();
        document.write("After Shift: " + fruits + "<br>");

        document.write("Array Length: " + fruits.length + "<br>");

        document.write("First Element: " + fruits[0] + "<br>");

        fruits.sort();
        document.write("Sorted Array: " + fruits + "<br>");
    </script>

</body>
</html>
